# ===== 大语言模型配置 =====
# LLM 提供商：openai / anthropic / ollama / openrouter
LLM_PROVIDER=openai
# 模型名称
LLM_MODEL=gpt-4o
# API 密钥
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# 自定义端点（可选，用于兼容 OpenAI 格式的代理）
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== LangGraph 配置 =====
# 最大迭代次数
GRAPH_MAX_ITERATIONS=10
# 超时时间（秒）
GRAPH_TIMEOUT_SECONDS=300
# 是否启用并行分支
GRAPH_PARALLEL_BRANCHES=true

# ===== RAG 配置 =====
# 嵌入模型
RAG_EMBEDDING_MODEL=text-embedding-3-small
# 检索返回条数
RAG_TOP_K=5
# 文档分块大小
RAG_CHUNK_SIZE=512
# 分块重叠大小
RAG_CHUNK_OVERLAP=64
# 向量库集合名
RAG_COLLECTION_NAME=code_standards
# 持久化目录
RAG_PERSIST_DIRECTORY=.cache/chroma

# ===== 智能体配置 =====
# 最大重试次数
AGENT_MAX_RETRIES=3
# 详细日志
AGENT_VERBOSE=false
# 缓存开关
AGENT_CACHE_ENABLED=true
# 并发任务数
AGENT_CONCURRENT_TASKS=3

# ===== 服务配置 =====
# 服务地址
HOST=0.0.0.0
# 服务端口
PORT=8000
# 调试模式
DEBUG=false

# ===== Docker 沙箱配置 =====
# 是否启用 Docker
DOCKER_ENABLED=false
# Docker 镜像
DOCKER_IMAGE=python:3.11-slim
# 工作目录
DOCKER_WORKING_DIR=/workspace

# ===== MCP 服务器配置 =====
# 格式：MCP_SERVERS={"server_name": {"command": "node", "args": ["script.js"]}}
# MCP_SERVERS={}
